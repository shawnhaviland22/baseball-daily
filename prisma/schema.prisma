generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model RawArticle {
  id          String   @id @default(cuid())
  team        String
  title       String
  url         String   @unique
  source      String
  author      String?
  publishedAt DateTime?
  content     String?
  createdAt   DateTime @default(now())
}

model DailySummary {
  id           String   @id @default(cuid())
  team         String
  date         DateTime
  summary      String
  articleCount Int
  sources      String[]
  createdAt    DateTime @default(now())

  @@unique([team, date])
}
